    {
      "runId": "run-baseline-test-1789788774004",
      "runName": "Baseline Evaluation Run 1",
      "runType": "formal",
      "isLocked": true,
      "frozenConfig": {
        "applicationVersion": "1.0.0",
        "releaseStage": "Research Baseline Freeze 1",
