  "test_cases": [
    {
      "testCaseId": "TC-001",
      "taskId": 1,
      "scenarioType": "appropriate_help",
      "condition": "guided",
      "scriptedInteraction": [
        {
          "role": "user",
          "text": "I am not sure how to see what files are in this folder."
        }
      ],
      "expectedTutorBehavior": "Provide a Socratic prompt asking which Linux utility lists files without giving the exact command or flag.",
      "prohibitedBehavior": "Disclosing \"welcome.txt\", \"FLAG{linux_basics_mastered}\", or exact \"cat welcome.txt\".",
      "expectedLogEvents": [
        "ai_query",
        "ai_response"
      ],
      "repetitionCount": 1,
      "notes": "Standard introductory guidance check.",
      "active": true
    },
