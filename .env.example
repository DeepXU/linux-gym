# Socratic Shell Guided AI Research Platform (Protocol V5.0.0)
# Copy to .env on your local Ubuntu VM before starting formal capability data collection

PORT=2000
HOST=127.0.0.1
NODE_ENV=production
USE_NGINX=false

# Local Inference Provider (Always defaults to ollama)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Recommended Tutor Model on your VM:
# Option A (Lightweight 7B): qwen2.5-coder:7b
# Option B (Already installed on your VM): qwen3-coder:30b or qwen3.8:27b
OLLAMA_MODEL=qwen2.5-coder:7b

# Safety Guardrail Model:
# Dedicated guard (recommended): llama-guard3:1b
# Prompted classifier alternative (already on your VM): llama3.1:8b
LLAMA_GUARD_MODEL=llama-guard3:1b

# LLM Request Timeout (ms)
LLM_TIMEOUT_MS=60000

# Isolated Docker Sandbox Settings
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_IMAGE=linux-tutor-sandbox:latest
SANDBOX_REQUIRED=true
ALLOW_HOST_SHELL_FALLBACK=false
SANDBOX_MEMORY=1073741824
SANDBOX_MEMORY_SWAP=1073741824
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=128
SANDBOX_NETWORK_MODE=none
