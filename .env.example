# =====================================================================
# Linux CTF Academy & Research Evaluation Platform
# Environment Configuration Template (.env.example)
# Dedicated Port Range: 2000 - 2009 (Zero conflict with Open WebUI / 3000s)
# =====================================================================

# ---------------------------------------------------------------------
# Application Server Networking
# ---------------------------------------------------------------------
# Primary Web UI, REST API & WebSocket Terminal Bridge (/pty)
# Dedicated Port: 2000 (Prevents conflict with Open WebUI on port 3000)
PORT=2000
NODE_ENV=production
ADMIN_INITIAL_PASSWORD=
# Optional comma-separated browser origins for reverse-proxy/cross-origin deployments.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------
# Local LLM Integration (NVIDIA RTX Pro 6000 Blackwell GPU)
# ---------------------------------------------------------------------
# Select active backend: 'ollama' | 'custom' (vLLM / LM Studio / llama.cpp) | 'gemini'
LLM_PROVIDER=ollama

# Provider 1: Local Ollama (Dedicated Port: 2004)
# Host-run Ollama should listen on loopback; Docker Compose uses its private service network.
# Run on port 2004: OLLAMA_HOST=127.0.0.1:2004 ollama serve
OLLAMA_BASE_URL=http://127.0.0.1:2004
OLLAMA_MODEL=qwen2.5-coder:7b
# Docker Compose uses this service-network URL; host-run development uses OLLAMA_BASE_URL above.
OLLAMA_BASE_URL_DOCKER=http://ollama:2004

# Provider 2: Local vLLM / OpenAI-Compatible Server (Dedicated Port: 2005)
# Run vLLM on port 2005: python3 -m vllm.entrypoints.openai.api_server --port 2005 ...
VLLM_BASE_URL=http://localhost:2005/v1
VLLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
OPENAI_API_KEY=EMPTY

# LLM Timeout in milliseconds (default: 60000ms for 70B models)
LLM_TIMEOUT_MS=60000

# ---------------------------------------------------------------------
# Meta Llama Guard 3 Safety Classifier (Port 2004)
# ---------------------------------------------------------------------
# Dedicated safety classification model (pull via: ollama pull llama-guard3:1b)
LLAMA_GUARD_MODEL=llama-guard3:1b
LLAMA_GUARD_TIMEOUT_MS=5000

# ---------------------------------------------------------------------
# Optional Cloud Provider Fallback (Google Gemini)
# ---------------------------------------------------------------------
# Leave empty if running 100% locally on the air-gapped / local GPU
GEMINI_API_KEY=

# ---------------------------------------------------------------------
# Docker Terminal Sandbox Isolation
# ---------------------------------------------------------------------
# Path to host Docker daemon socket for isolated student containers
DOCKER_SOCKET_PATH=/var/run/docker.sock
# Build from Dockerfile.sandbox before starting the application.
DOCKER_IMAGE=linux-tutor-sandbox:latest

# ---------------------------------------------------------------------
# Application Port Allocation Matrix (Ports 2000-2009)
# ---------------------------------------------------------------------
# Port 2000 : Main Web Application & Terminal WebSocket PTY Bridge
# Port 2001 : Nginx Reverse Proxy (Frontend & SSL Gateway)
# Port 2002 : Direct Sandbox SSH / CTF Gym Container Target
# Port 2003 : Secondary Network Challenge Service (TCP/HTTP)
# Port 2004 : Local Ollama Server (RTX Pro 6000 GPU)
# Port 2005 : Local vLLM / OpenAI-Compatible Server (RTX Pro 6000 GPU)
# Port 2006 : Alternative LLM Engine (llama.cpp / LM Studio)
# Port 2007 : System Health & Prometheus Metrics (Optional)
# Port 2008 : Real-Time Research Telemetry Event Stream
# Port 2009 : Administrative Diagnostics / Fallback Port
