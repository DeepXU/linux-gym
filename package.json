{
  "name": "socratic-shell",
  "version": "1.0.0",
  "description": "Socratic Shell — Evidence-Grounded Socratic Linux & Cybersecurity Terminal Lab",
  "main": "index.html",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "test": "tsx --test tests/**/*.test.ts",
    "test:sandbox-smoke": "tsx scripts/study_cli.ts sandbox-smoke",
    "study:backup": "tsx scripts/study_cli.ts backup",
    "study:reset": "tsx scripts/study_cli.ts reset",
    "study:verify": "tsx scripts/study_cli.ts verify",
    "verify:collection-ready": "tsx scripts/study_cli.ts collection-ready",
    "verify:preflight-evidence": "tsx scripts/verify_preflight_evidence.ts",
    "lint": "tsc --noEmit",
    "check": "bash check_deployment.sh",
    "verify": "bash check_deployment.sh"
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cors": "^2.8.6",
    "dockerode": "^5.0.1",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/jszip": "^3.4.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
